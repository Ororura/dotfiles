# ============================================================
# Ollama Git AI Configuration
# ============================================================

# Ollama HTTP API

export OLLAMA_GIT_URL="http://127.0.0.1:11434/api/chat"

# Default model

export OLLAMA_GIT_MODEL="qwen3.5:9b"

# Optional task-specific models

# Uncomment only the commands that need a different model.
# export OLLAMA_GIT_COMMIT_MODEL="qwen3.5:9b"
# export OLLAMA_GIT_BRANCH_MODEL="qwen3.5:9b"
# export OLLAMA_GIT_REVIEW_MODEL="qwen3.5:9b"
# export OLLAMA_GIT_PR_MODEL="qwen3.5:9b"
# export OLLAMA_GIT_SPLIT_MODEL="qwen3.5:9b"
# export OLLAMA_GIT_CHANGELOG_MODEL="qwen3.5:9b"
# export OLLAMA_GIT_EXPLAIN_MODEL="qwen3.5:9b"

# Maximum diff size per request

export OLLAMA_GIT_MAX_DIFF_CHARS="20000"

# Model context

export OLLAMA_GIT_CONTEXT="8192"

# Optional Ollama model retention (default: 3m)
# export OLLAMA_GIT_KEEP_ALIVE="3m"
